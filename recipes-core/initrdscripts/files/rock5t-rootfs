# shellcheck disable=SC1091
. /usr/libexec/os-helpers-fs
. /usr/libexec/os-helpers-logging

rootfs_enabled() {
    return 0
}

rock5t_root_fallback() {
    timeout=${ROCK5T_ROOT_FALLBACK_TIMEOUT:-60}
    for candidate in \
        /dev/disk/by-state/resin-rootA \
        /dev/disk/by-label/resin-rootA \
        /dev/disk/by-partlabel/resin-rootA
    do
        if wait4file "$candidate" "$((timeout * 10))"; then
            info "ROCK 5T: stale root UUID; falling back to $candidate."
            bootparam_root="$candidate"
            return 0
        fi
    done

    info "ROCK 5T: rootA fallback links did not appear; keeping by-label rootA device."
    bootparam_root="/dev/disk/by-label/resin-rootA"
}

# Record the mounted root's real filesystem UUID for the full OS.
# resin_update_state_probe reads /run/initramfs/bootparam_root (as "UUID=...")
# to create /dev/disk/by-state/{active,resin-rootA}. Because we resolve root by
# label (not root=UUID=), and fsuuidsinit bails without those by-state links,
# nobody else writes this file — so by-state/active never appears and
# disk-watchdogd StartLimitAction=reboot-force loops the board. Derive the UUID
# from the by-uuid symlinks udev/coldplug already created (no lsblk/blkid needed).
rock5t_record_root_uuid() {
    _dev="$(readlink -f "$1")" || return 0
    for _link in /dev/disk/by-uuid/*; do
        [ -e "$_link" ] || continue
        if [ "$(readlink -f "$_link")" = "$_dev" ]; then
            mkdir -p /run/initramfs
            echo "UUID=${_link##*/}" > /run/initramfs/bootparam_root
            info "ROCK 5T: recorded root UUID ${_link##*/} for by-state probe."
            return 0
        fi
    done
    info "ROCK 5T: no by-uuid link for $_dev; by-state/active may not be created."
}

rootfs_run() {
    if [ -z "$ROOTFS_DIR" ]; then
        return
    fi
    C=0
    delay=${bootparam_rootdelay:-1}
    timeout=${bootparam_roottimeout:-5}
    while [ ! -d $ROOTFS_DIR/dev ]; do
        if [ $(( C * delay )) -gt $timeout ]; then
            fatal "root '$bootparam_root' doesn't exist or does not contain a /dev."
        fi

        if [ -n "$bootparam_root" ]; then
            debug "No e2fs compatible filesystem has been mounted, mounting $bootparam_root..."

            if [ "$(echo "${bootparam_root}" | cut -c1-5)" = "UUID=" ]; then
                root_uuid=$(echo "$bootparam_root" | cut -c6-)
                # If the UUIDs have been regenerated there is no by-uuid link.
                # Flasher does not use dynamically generated UUIDs; always use
                # the by-uuid link for it.
                if [ "${bootparam_flasher}" = "true" ] || [ -L "/dev/disk/by-uuid/$root_uuid" ]; then
                    bootparam_root="/dev/disk/by-uuid/$root_uuid"
                else
                    rock5t_root_fallback
                fi
            fi

            if [ "$(echo "${bootparam_root}" | cut -c1-9)" = "PARTUUID=" ]; then
                root_uuid=$(echo "$bootparam_root" | cut -c10-)
                bootparam_root="/dev/disk/by-partuuid/$root_uuid"
            fi

            if [ "$(echo "${bootparam_root}" | cut -c1-6)" = "LABEL=" ]; then
                root_label=$(echo "$bootparam_root" | cut -c7-)
                bootparam_root="$(get_state_path_from_label "$root_label")"
                if [ "${bootparam_flasher}" = "true" ] && [ ! -L "${bootparam_root}" ]; then
                    bootparam_root="/dev/disk/by-label/$root_label"
                fi
                info "Using bootparam_root $bootparam_root for $root_label"
            fi

            if [ -e "$bootparam_root" ]; then
                flags=""
                if [ -n "$bootparam_ro" ] && ! echo "$bootparam_rootflags" | grep -w -q "ro"; then
                    if [ -n "$bootparam_rootflags" ]; then
                        bootparam_rootflags="$bootparam_rootflags,"
                    fi
                    bootparam_rootflags="${bootparam_rootflags}ro"
                fi
                if [ -n "$bootparam_rootflags" ]; then
                    flags="$flags -o$bootparam_rootflags"
                fi
                if [ -n "$bootparam_rootfstype" ]; then
                    flags="$flags -t$bootparam_rootfstype"
                fi
                info "Using $bootparam_root as root filesystem."
                mount $flags "$bootparam_root" "$ROOTFS_DIR"
                if [ -d $ROOTFS_DIR/dev ]; then
                    rock5t_record_root_uuid "$bootparam_root"
                    break
                else
                    # It is unlikely to change, but keep trying anyway.
                    # Perhaps we pick a different device next time.
                    umount "$ROOTFS_DIR"
                fi
            elif [ "$bootparam_root" = "/dev/disk/by-state/active" ]; then
                rock5t_root_fallback
            fi
        fi
        debug "Sleeping for $delay second(s) to wait root to settle..."
        sleep $delay
        C=$(( C + 1 ))
    done
}
